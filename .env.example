# Public configuration only. Do not put wallet secrets in this file or the repository.
SEPOLIA_RPC_URL=https://YOUR_SEPOLIA_RPC
LISTPROOF_PUBLISHER=0xYOUR_PUBLISHER_ADDRESS
LISTPROOF_REGISTRY=0xYOUR_VERIFIED_REGISTRY_ADDRESS
LISTPROOF_GATE=0xYOUR_VERIFIED_GATE_ADDRESS
LISTPROOF_FORWARDER=0xOFFICIAL_SEPOLIA_FORWARDER_FROM_CRE_CLI
LISTPROOF_WORKFLOW_ID=0xWORKFLOW_ID_FROM_CRE_DEPLOYMENT
LISTPROOF_RECEIVER=0xYOUR_VERIFIED_RECEIVER_ADDRESS

# V4 private workspace. Set DATABASE_URL only on a host with persistent PostgreSQL.
# Keep these values in the hosting provider's secret manager, not in this file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# LISTPROOF_DB_SSL=verify
# LISTPROOF_OWNER_EMAIL=owner@example.com
# LISTPROOF_OWNER_PASSWORD=SET_A_UNIQUE_12_PLUS_CHARACTER_SECRET
# LISTPROOF_ORG_SLUG=listproof
# LISTPROOF_ORG_NAME=ListProof Workspace
# For local development only: LISTPROOF_DB_PATH=./data/listproof-local.sqlite
